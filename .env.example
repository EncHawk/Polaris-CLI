# ─── Polaris CLI · BYOK configuration ───────────────────────────────────────────
# Copy to .env and fill in. Bun loads .env automatically.
# The CLI runs fully standalone on your filesystem — no sandbox, no cloud infra.

# LLM provider (any OpenAI-compatible endpoint). Bring your own key.
POLARIS_API_KEY=
POLARIS_BASE_URL=https://api.deepinfra.com/v1/openai
POLARIS_DEFAULT_MODEL=deepseek-ai/DeepSeek-V3.2-Flash

# Per-agent model overrides (optional). Fall back to POLARIS_DEFAULT_MODEL.
POLARIS_READ_MODEL=
POLARIS_RESEARCH_MODEL=
POLARIS_PLAN_MODEL=
POLARIS_CODE_MODEL=
POLARIS_ORCHESTRATOR_MODEL=

# Keep a stuck model bounded (internal ReAct iterations per agent call).
POLARIS_AGENT_MAX_STEPS=4
POLARIS_ARXIV_MAX_CITATIONS=8

# ─── CODE agent output ──────────────────────────────────────────────────────────
# Where project directories are created. Defaults to the current working
# directory, so `polaris run 2106.09685` creates ./paper-2106-09685/.
POLARIS_OUTPUT_DIR=

# ─── trueForge harness (used by `polaris serve` / `polaris setup`) ───────────────
# Local trueForge server is managed automatically; override port/data dir here.
POLARIS_TRUEFORGE_PORT=8790
POLARIS_TRUEFORGE_SQLITE_PATH=
# If you already run a trueForge server elsewhere, point the SDK at it:
POLARIS_TRUEFORGE_BASE_URL=

# ─── GitHub publishing (optional) ───────────────────────────────────────────────
GITHUB_ACCESS_TOKEN=
GITHUB_ORG=Polaris-Implementations
GITHUB_API_URL=https://api.github.com
GITHUB_REPO_PRIVATE=false

# ─── Polaris coded-implementation library (read-only retrieval) ────────────────
# The GitHub org holding our coded paper reproductions (paper-YYMM-NNNNN).
# The MCP search_polaris_papers / get_polaris_implementation tools read from here
# so coding agents can reuse existing implementations instead of starting fresh.
# Reuses GITHUB_ACCESS_TOKEN for a higher rate limit when set.
POLARIS_PAPERS_ORG=PolarisAI-Implementations

# Where newly generated implementations are pushed. Defaults to POLARIS_PAPERS_ORG
# so generated reproductions join the library and become retrievable by future runs.
# Set to a separate org to keep them apart.
POLARIS_PUBLISH_ORG=PolarisAI-Implementations
