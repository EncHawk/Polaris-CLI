# npm registry + publish auth (uses env var — never commit a real token)
registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
# To publish:
#   1. Create an npm automation token at https://www.npmjs.com/settings/tokens
#   2. export NPM_TOKEN=npm_xxxxxxxxxxxxxxxx
#   3. bun run build  # builds dist/ (also runs automatically via prepublishOnly)
#   4. npm publish --access public
# In CI (GitHub Actions): set NPM_TOKEN as a repo secret and run `npm publish`.
